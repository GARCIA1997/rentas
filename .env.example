# Database
DB_USER=rentas
DB_PASSWORD=rentas_dev
DB_NAME=rentas_db
# DB_HOST_PORT: host-side port mapping for postgres (change if 5442 is taken locally)
DB_HOST_PORT=5442
DATABASE_URL=postgresql://rentas:rentas_dev@localhost:5442/rentas_db

# Node Environment
NODE_ENV=development

# JWT
JWT_SECRET=dev_secret_key_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_key

# API Configuration
# BACKEND_HOST_PORT: host-side port mapping for backend (change if 4000 is taken locally)
BACKEND_HOST_PORT=4000
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Next.js Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=KsaRed

# Web Push (VAPID) — generar un par por entorno con:
#   docker compose exec backend npx web-push generate-vapid-keys --json
# NUNCA reusar el mismo par entre entornos. VAPID_PUBLIC_KEY y
# NEXT_PUBLIC_VAPID_PUBLIC_KEY deben tener el MISMO valor (uno lo usa el backend
# para firmar, el otro lo usa el navegador para suscribirse) — VAPID_PRIVATE_KEY
# nunca se expone al frontend. VAPID_SUBJECT es un mailto: o https: de contacto,
# lo exige el estándar para que los navegadores puedan reportar abuso.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Seed: credenciales del usuario administrador inicial.
# Definir SEED_ADMIN_PASSWORD antes de correr `npm run db:seed` en cualquier
# entorno real; sin ella se usa una contraseña de desarrollo conocida.
SEED_ADMIN_PHONE=5550000000
SEED_ADMIN_PASSWORD=changeme-dev-only
