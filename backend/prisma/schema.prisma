// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  INQUILINO
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PropertyType {
  HOUSE
  LOCAL
}

enum PropertyStatus {
  OCUPADA
  LIBRE
  MANTENIMIENTO
}

enum TenantStatus {
  ACTIVE
  EVICTED
  MOVED_OUT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  AUTO_RENEWAL_PENDING
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  MANUAL
  TRANSFERENCIA
  EFECTIVO
  CHEQUE
}

enum NotificationType {
  PAYMENT_REMINDER
  PAYMENT_CONFIRMED
  CONTRACT_SIGNED
  MAINTENANCE_REPORT
}

// Models
model User {
  id                    String      @id @default(cuid())
  phone                 String      @unique @db.VarChar(10)
  passwordHash          String
  firstName             String
  lastName              String
  email                 String?
  role                  UserRole    @default(INQUILINO)
  status                UserStatus  @default(ACTIVE)
  createdBy             String?     // FK to User for audit trail
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  properties            Property[]
  tenants               Tenant[]
  contractTemplates     ContractTemplate[]
  notificationLogs      NotificationLog[]
  representatives       Representative[]
  createdUsers          User[]      @relation("UserCreatedBy")
  creatorUser           User?       @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([role])
}

model Property {
  id                    String      @id @default(cuid())
  ownerId               String
  name                  String
  address               String
  city                  String
  postalCode            String
  propertyType          PropertyType
  status                PropertyStatus  @default(LIBRE)
  rentalPrice           Decimal     @db.Decimal(12, 2)
  waterIncluded         Boolean     @default(false)
  maintenanceNotes      String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  owner                 User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenants               Tenant[]
  contracts             Contract[]
  rentPayments          RentPayment[]

  @@index([ownerId])
  @@index([status])
}

model Tenant {
  id                    String      @id @default(cuid())
  propertyId            String
  userId                String?
  fullName              String
  email                 String?
  phone                 String?
  idDocument            String?
  moveInDate            DateTime
  status                TenantStatus @default(ACTIVE)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  property              Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts             Contract[]
  rentPayments          RentPayment[]
  maintenanceReports    MaintenanceReport[]

  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

model Contract {
  id                    String      @id @default(cuid())
  tenantId              String
  propertyId            String
  representativeId      String?
  startDate             DateTime
  endDate               DateTime
  monthlyRent           Decimal     @db.Decimal(12, 2)
  depositAmount         Decimal     @db.Decimal(12, 2)
  waterIncluded         Boolean     @default(false)
  depositReturnPolicy   Json?       // JSON for flexibility: {condition: "perfect/minor/major", percentage: 100}
  penaltyRules          Json?       // JSON: {latePaymentPenalty: 2, maxDamageCharge: 5000}
  terms                 Json?       // JSON: array of custom clauses
  templateUsed          String?
  signedAt              DateTime?
  signedDigitallyPhone  Boolean     @default(false)
  documentUrl           String?
  status                ContractStatus  @default(DRAFT)
  autoRenewal           Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property              Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  representative        Representative? @relation(fields: [representativeId], references: [id], onDelete: SetNull)
  rentPayments          RentPayment[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([representativeId])
  @@index([status])
}

model Representative {
  id                    String      @id @default(cuid())
  fullName              String
  position              String?     // cargo, e.g. "Administrador"
  idDocument            String?     // INE/CURP
  phone                 String?
  email                 String?
  signatureImageUrl     String?
  isActive              Boolean     @default(true)
  createdBy             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  creator               User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  contracts             Contract[]

  @@index([isActive])
}

model ContractTemplate {
  id                    String      @id @default(cuid())
  name                  String
  templateContent       String      @db.Text
  variables             Json        // Array of variable names: ["tenant_name", "property_address", etc]
  isDefault             Boolean     @default(false)
  createdBy             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  creator               User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([isDefault])
}

model RentPayment {
  id                    String      @id @default(cuid())
  contractId            String
  tenantId              String
  propertyId            String
  amountDue             Decimal     @db.Decimal(12, 2)
  amountPaid            Decimal     @db.Decimal(12, 2) @default(0)
  dueDate               DateTime
  paidDate              DateTime?
  paymentMethod         PaymentMethod
  notes                 String?
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  contract              Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property              Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([tenantId])
  @@index([dueDate])
  @@index([status])
}

model MaintenanceReport {
  id                    String      @id @default(cuid())
  tenantId              String
  propertyId            String?
  description           String      @db.Text
  priority              String      @default("normal") // low, normal, high
  status                String      @default("reported") // reported, in_progress, completed
  reportedDate          DateTime    @default(now())
  completedDate         DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model NotificationLog {
  id                    String      @id @default(cuid())
  userId                String
  notificationType      NotificationType
  whatsappMessage       String      @db.Text
  sentAt                DateTime    @default(now())
  readAt                DateTime?
  createdAt             DateTime    @default(now())

  // Relations
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([notificationType])
}
