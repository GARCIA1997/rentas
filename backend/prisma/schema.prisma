// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  INQUILINO
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PropertyType {
  HOUSE
  LOCAL
}

enum PropertyStatus {
  OCUPADA
  LIBRE
  MANTENIMIENTO
}

enum TenantStatus {
  ACTIVE
  EVICTED
  MOVED_OUT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  AUTO_RENEWAL_PENDING
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  MANUAL
  TRANSFERENCIA
  EFECTIVO
  CHEQUE
}

enum PaymentType {
  RENT
  DEPOSIT
  EXTRA
}

enum NotificationType {
  PAYMENT_REMINDER
  PAYMENT_CONFIRMED
  CONTRACT_SIGNED
  MAINTENANCE_REPORT
}

// Models
model User {
  id                    String      @id @default(cuid())
  phone                 String      @unique @db.VarChar(10)
  passwordHash          String
  firstName             String
  lastName              String
  email                 String?
  role                  UserRole    @default(INQUILINO)
  status                UserStatus  @default(ACTIVE)
  notificationsEnabled  Boolean     @default(true)
  createdBy             String?     // FK to User for audit trail
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  properties            Property[]
  tenants               Tenant[]
  contractTemplates     ContractTemplate[]
  notificationLogs      NotificationLog[]
  representatives       Representative[]
  createdUsers          User[]      @relation("UserCreatedBy")
  creatorUser           User?       @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdInvites        RegistrationInvite[] @relation("InviteCreator")
  usedInvites           RegistrationInvite[] @relation("InviteUsedBy")

  @@index([phone])
  @@index([role])
}

model Property {
  id                    String      @id @default(cuid())
  ownerId               String
  name                  String
  address               String
  city                  String
  postalCode            String
  propertyType          PropertyType
  status                PropertyStatus  @default(LIBRE)
  rentalPrice           Decimal     @db.Decimal(12, 2)
  waterIncluded         Boolean     @default(false)
  bedrooms              Int?
  bathrooms             Int?
  maintenanceNotes      String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  owner                 User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contracts             Contract[]
  rentPayments          RentPayment[]

  @@index([ownerId])
  @@index([status])
}

// A Tenant is a person profile only. Which property they occupy, since when,
// and on what terms lives on Contract (tenantId + propertyId + startDate) —
// a tenant can have multiple contracts over time (different properties across
// different periods), so there is no direct Tenant -> Property relation.
model Tenant {
  id                    String      @id @default(cuid())
  userId                String?
  fullName              String
  email                 String?
  phone                 String?
  idDocument            String?     // Clave de elector (INE), distinta de la CURP
  status                TenantStatus @default(ACTIVE)
  notes                 String?
  // Capturados al escanear el INE (ver /tenants/new); todos opcionales porque el alta
  // manual (sin escaneo) sigue siendo un camino válido.
  address               String?     @db.Text
  curp                  String?     @db.VarChar(18)
  birthDate             DateTime?
  // Fotos del INE guardadas como respaldo — decisión explícita del usuario de conservarlas,
  // no sólo procesarlas y descartarlas. Rutas relativas bajo uploads/tenants/{id}/, servidas
  // sólo vía endpoints autenticados de admin (nunca públicas, son datos personales sensibles).
  ineFrontUrl           String?
  ineBackUrl            String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts             Contract[]
  rentPayments          RentPayment[]
  maintenanceReports    MaintenanceReport[]
  invites               RegistrationInvite[]

  @@index([userId])
  @@index([status])
}

model Contract {
  id                    String      @id @default(cuid())
  tenantId              String
  propertyId            String
  representativeId      String?
  previousContractId    String?     // FK to previous contract if this is a renewal
  startDate             DateTime
  durationMonths        Int         // Reemplaza endDate - duración en meses (ej: 12 para un año)
  paymentDay            Int         // Día del mes para pagos (1-31, ej: 7 = pagos el 7 de cada mes)
  endDate               DateTime?   // Calculado: startDate + durationMonths, para backward compat
  monthlyRent           Decimal     @db.Decimal(12, 2)
  depositAmount         Decimal     @db.Decimal(12, 2)
  waterIncluded         Boolean     @default(false)
  depositReturnPolicy   Json?       // JSON for flexibility: {condition: "perfect/minor/major", percentage: 100}
  penaltyRules          Json?       // JSON: {latePaymentPenalty: 2, maxDamageCharge: 5000}
  terms                 Json?       // JSON: array of custom clauses
  inventory             Json?       // JSON: array of items included {name, condition, notes}
  utilities             Json?       // JSON: {water, electricity, gas, etc} - who pays (tenant/landlord/included)
  convivanceRules       String?     // Convivencia, ruidos, horarios permitidos
  witnessInfo           Json?       // JSON: {name, phone, signature} - referencia de testigo
  landlordsInfo         Json?       // JSON: {name, phone, email} - datos del arrendador
  templateUsed          String      // Template ID for PDF generation - REQUIRED
  signedAt              DateTime?
  signedDigitallyPhone  Boolean     @default(false)
  documentUrl           String?
  status                ContractStatus  @default(DRAFT)
  autoRenewal           Boolean     @default(false)
  cancellationReason    String?
  cancelledAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property              Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  representative        Representative? @relation(fields: [representativeId], references: [id], onDelete: SetNull)
  previousContract      Contract?   @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewedContracts      Contract[]  @relation("ContractRenewal")
  rentPayments          RentPayment[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([representativeId])
  @@index([status])
  @@index([previousContractId])
}

model Representative {
  id                    String      @id @default(cuid())
  fullName              String
  position              String?     // cargo, e.g. "Administrador"
  idDocument            String?     // INE/CURP
  phone                 String?
  email                 String?
  signatureImageUrl     String?
  isActive              Boolean     @default(true)
  createdBy             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  creator               User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  contracts             Contract[]

  @@index([isActive])
}

model ContractTemplate {
  id                    String      @id @default(cuid())
  name                  String
  templateContent       String      @db.Text
  variables             Json        // Array of variable names: ["tenant_name", "property_address", etc]
  // Tipo de inmueble al que aplica la plantilla. null = agnóstica (sirve para cualquiera).
  // Evita emparejar un local comercial con el contrato de casa habitación, cuyo clausulado
  // declara un destino distinto.
  propertyType          PropertyType?
  isDefault             Boolean     @default(false)
  createdBy             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  creator               User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([isDefault])
}

model RentPayment {
  id                    String      @id @default(cuid())
  contractId            String
  tenantId              String
  propertyId            String
  amountDue             Decimal     @db.Decimal(12, 2)
  amountPaid            Decimal     @db.Decimal(12, 2) @default(0)
  dueDate               DateTime
  paidDate              DateTime?
  paymentMethod         PaymentMethod
  paymentType           PaymentType @default(RENT)  // RENT, DEPOSIT, EXTRA
  paymentNumber         Int?        // Ej: 1 para el primer pago, 2 para el segundo, etc
  totalPaymentsInContract Int?      // Ej: 12 si el contrato tiene 12 pagos - para mostrar "1/12"
  notes                 String?
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  contract              Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property              Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([tenantId])
  @@index([dueDate])
  @@index([status])
}

model MaintenanceReport {
  id                    String      @id @default(cuid())
  tenantId              String
  propertyId            String?
  description           String      @db.Text
  priority              String      @default("normal") // low, normal, high
  status                String      @default("reported") // reported, in_progress, completed
  reportedDate          DateTime    @default(now())
  completedDate         DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model NotificationLog {
  id                    String      @id @default(cuid())
  userId                String
  notificationType      NotificationType
  whatsappMessage       String      @db.Text
  sentAt                DateTime    @default(now())
  readAt                DateTime?
  createdAt             DateTime    @default(now())

  // Relations
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([notificationType])
}

// Único mecanismo de alta de cuentas: no hay registro público abierto. Un admin genera
// una invitación (ADMIN, o INQUILINO ligada a un Tenant que ya existe) y comparte el link
// con token; quien lo abre ve sólo lo que le corresponde y, al aceptar, el token se
// consume — de un solo uso, con vencimiento.
model RegistrationInvite {
  id                    String      @id @default(cuid())
  token                 String      @unique
  role                  UserRole
  tenantId              String?     // requerido cuando role = INQUILINO; a qué Tenant se liga
  createdBy             String
  expiresAt             DateTime
  usedAt                DateTime?
  usedByUserId          String?
  createdAt             DateTime    @default(now())

  // Relations
  tenant                Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator               User        @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  usedBy                User?       @relation("InviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([tenantId])
}
